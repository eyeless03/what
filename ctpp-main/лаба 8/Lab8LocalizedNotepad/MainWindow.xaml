<Window x:Class="Lab8LocalizedNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="660"
        Width="980"
        MinHeight="580"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F7F3E8"
        Closing="Window_OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Background="#4C3A75" Foreground="White" FontWeight="SemiBold">
            <MenuItem Header="{Binding FileMenu}">
                <MenuItem Header="{Binding NewText}" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                <MenuItem Header="{Binding OpenText}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <MenuItem Header="{Binding SaveText}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding CloseText}" Command="{Binding CloseCommand}"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Margin="18" Padding="18" Background="#EFE7DA" BorderBrush="#D3C6B8" BorderThickness="1.5" CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding LabTitle}" Foreground="#6B5C84" FontSize="13"/>
                    <TextBlock Text="{Binding AppTitle}" Foreground="#2D243D" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="{Binding FilePathText}" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding LanguageText}" Foreground="#2D243D" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="34"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <Border Background="#FFFDF8" BorderBrush="#C5B9AB" BorderThickness="1.5" CornerRadius="14,0,0,14">
                <TextBox Text="{Binding DocumentText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="18"
                         FontFamily="Consolas"
                         FontSize="16"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#1F2937"
                         CaretBrush="#4C3A75"/>
            </Border>
            <Border Grid.Column="1" Padding="16" Background="#2D243D" CornerRadius="0,14,14,0">
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UnsavedText}" Foreground="#FBBF24" Margin="0,8,0,16" TextWrapping="Wrap"/>
                    <Border Padding="12" Background="#403457" CornerRadius="10">
                        <TextBlock Text="{Binding StatisticsText}" Foreground="#EDE9FE" TextWrapping="Wrap"/>
                    </Border>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="{Binding NewText}" Command="{Binding NewCommand}" Margin="0,0,8,8" Padding="12,7"/>
                        <Button Content="{Binding OpenText}" Command="{Binding OpenCommand}" Margin="0,0,8,8" Padding="12,7"/>
                        <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Margin="0,0,8,8" Padding="12,7"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="18,12,18,16" Padding="12,8" Background="#4C3A75" CornerRadius="10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
