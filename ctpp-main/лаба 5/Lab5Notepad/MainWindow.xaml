<Window x:Class="Lab5Notepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5Notepad"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="680"
        Width="980"
        MinHeight="580"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#E7ECE7"
        Closing="Window_OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <local:BooleanToTextWrappingConverter x:Key="BooleanToTextWrappingConverter"/>

        <SolidColorBrush x:Key="InkBrush" Color="#17212B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFFCF1"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#DDEEE3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#176B52"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#C8EAD8"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#D94E3F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#AEB8AA"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="#153F34"
              Foreground="White"
              FontWeight="SemiBold">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                <MenuItem Header="Открыть" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <Separator/>
                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Сохранить как" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Перенос строк"
                          IsCheckable="True"
                          IsChecked="{Binding IsWrappingEnabled, Mode=TwoWay}"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Margin="18,16,18,12"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#8CB69C"
                BorderThickness="1.5"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Лабораторная работа 5"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"/>
                    <TextBlock Text="Блокнот с командами"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="30"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding FilePathText}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Новый" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Открыть" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CoralBrush}"
                    CornerRadius="14,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TXT"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="UTF-8"
                               Foreground="#FFE4E0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="#7F8C7B"
                    BorderThickness="1.5,1.5,0,1.5">
                <TextBox x:Name="EditorTextBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Padding="20"
                         FontFamily="Consolas"
                         FontSize="16"
                         Background="Transparent"
                         Foreground="{StaticResource InkBrush}"
                         BorderThickness="0"
                         CaretBrush="{StaticResource CoralBrush}"
                         TextWrapping="{Binding IsWrappingEnabled, Converter={StaticResource BooleanToTextWrappingConverter}, Mode=OneWay}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding DocumentText, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="#F4EEDC"
                    BorderBrush="#7F8C7B"
                    BorderThickness="1.5"
                    CornerRadius="0,14,14,0">
                <StackPanel>
                    <TextBlock Text="Сводка"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>
                    <Border Padding="12"
                            Background="White"
                            BorderBrush="#E7DEC9"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding UnsavedText}"
                                       Foreground="{StaticResource CoralBrush}"
                                       FontSize="13"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12"
                            Margin="0,12,0,0"
                            Background="White"
                            BorderBrush="#E7DEC9"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Показатели текста"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatisticsText}"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12"
                            Margin="0,12,0,0"
                            Background="{StaticResource AccentLightBrush}"
                            CornerRadius="10">
                        <TextBlock Text="Команды доступны из меню, с панели действий и через клавиатуру: Ctrl+N, Ctrl+O, Ctrl+S."
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <CheckBox Content="{Binding WrapModeText}"
                              Margin="0,14,0,0"
                              Foreground="{StaticResource InkBrush}"
                              FontWeight="SemiBold"
                              IsChecked="{Binding IsWrappingEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="18,12,18,16"
                Padding="12,8"
                Background="#153F34"
                BorderBrush="#0B2C25"
                BorderThickness="1.5"
                CornerRadius="10">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding WrapModeText}"
                           Foreground="#C8EAD8"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
