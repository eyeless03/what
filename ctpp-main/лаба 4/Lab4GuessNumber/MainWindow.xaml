<Window x:Class="Lab4GuessNumber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Угадай число"
        Height="650"
        Width="920"
        MinHeight="590"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#111827">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#243447"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A7B0BD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0F8FC5"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Лабораторная работа 4"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"/>
                <TextBlock Text="Угадай число"
                           FontSize="32"
                           FontWeight="Bold"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Padding="14,8"
                    Background="#182331"
                    CornerRadius="10"
                    VerticalAlignment="Bottom">
                <TextBlock Text="{Binding BestAttemptsText}"
                           Foreground="{StaticResource WarningBrush}"
                           FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding RangeText}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="16"/>

                    <Border Grid.Row="1"
                            Margin="0,18,0,14"
                            Padding="18"
                            Background="#0F172A"
                            BorderBrush="{Binding StatusBrush}"
                            BorderThickness="1.5"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="{Binding Message}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Hint}"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Temperature}"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Height="46"
                                 Padding="14,0"
                                 FontSize="20"
                                 VerticalContentAlignment="Center"
                                 Background="#E0F2FE"
                                 Foreground="#111827"
                                 BorderBrush="{StaticResource AccentBrush}"
                                 CaretBrush="#111827"
                                 Text="{Binding CurrentGuessText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2"
                                Content="Проверить"
                                IsDefault="True"
                                Command="{Binding GuessCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding AttemptProgress, Mode=OneWay}"
                                     Background="#0F172A"
                                     Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AttemptsText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <WrapPanel Grid.Row="4" Margin="0,0,0,18">
                        <Button Content="Новая игра"
                                Command="{Binding NewGameCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,10"/>
                    </WrapPanel>

                    <Border Grid.Row="5"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="История попыток"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding GuessHistory}"
                                     DisplayMemberPath="Text"
                                     Background="#17212F"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#334155"
                                     Padding="6"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Сложность"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Difficulties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDifficultyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        Background="#17212F"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="14"
                            Background="#17212F"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="12"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Фишки"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="• подсказки больше/меньше"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• индикатор теплее/холоднее"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• история попыток"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• рекорд сохраняется в файл"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• новая игра без перезапуска"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
