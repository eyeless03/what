<Window x:Class="Lab2Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Калькулятор"
        Height="600"
        Width="780"
        MinHeight="560"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#16202A"
        KeyDown="Window_OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#22313F"/>
        <SolidColorBrush x:Key="DisplayBrush" Color="#101820"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8B3BD"/>
        <SolidColorBrush x:Key="NumberBrush" Color="#2F4254"/>
        <SolidColorBrush x:Key="MemoryBrush" Color="#5A7184"/>
        <SolidColorBrush x:Key="OperationBrush" Color="#1FA2A8"/>
        <SolidColorBrush x:Key="EqualsBrush" Color="#F4B942"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E0645F"/>

        <Style x:Key="CalculatorButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource NumberBrush}"/>
            <Setter Property="BorderBrush" Value="#456074"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MemoryButtonStyle" BasedOn="{StaticResource CalculatorButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MemoryBrush}"/>
        </Style>

        <Style x:Key="OperationButtonStyle" BasedOn="{StaticResource CalculatorButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OperationBrush}"/>
            <Setter Property="BorderBrush" Value="#48C8CC"/>
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource CalculatorButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="#F18B87"/>
        </Style>

        <Style x:Key="EqualsButtonStyle" BasedOn="{StaticResource CalculatorButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource EqualsBrush}"/>
            <Setter Property="Foreground" Value="#1A2128"/>
            <Setter Property="BorderBrush" Value="#FFD36B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.15*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,14,0"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="Лабораторная работа 2"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               DockPanel.Dock="Top"/>
                    <TextBlock Text="Калькулятор"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="28"
                               FontWeight="Bold"/>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource DisplayBrush}"
                        BorderBrush="#33485B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,0,10">
                    <TextBox x:Name="DisplayTextBox"
                             Height="58"
                             FontSize="30"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             CaretBrush="{StaticResource EqualsBrush}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             Text="0"/>
                </Border>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="2"
                           MinHeight="22"
                           Margin="2,0,2,14"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Введите выражение кнопками или с клавиатуры."/>

                <UniformGrid Grid.Row="3"
                             Rows="5"
                             Columns="4">
                    <Button Content="C" Click="ClearButton_OnClick" Style="{StaticResource DangerButtonStyle}"/>
                    <Button Content="(" Click="Button_OnClick" Style="{StaticResource MemoryButtonStyle}"/>
                    <Button Content=")" Click="Button_OnClick" Style="{StaticResource MemoryButtonStyle}"/>
                    <Button Content="/" Click="Button_OnClick" Style="{StaticResource OperationButtonStyle}"/>

                    <Button Content="7" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="8" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="9" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="*" Click="Button_OnClick" Style="{StaticResource OperationButtonStyle}"/>

                    <Button Content="4" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="5" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="6" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="-" Click="Button_OnClick" Style="{StaticResource OperationButtonStyle}"/>

                    <Button Content="1" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="2" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="3" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="+" Click="Button_OnClick" Style="{StaticResource OperationButtonStyle}"/>

                    <Button Content="0" Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="." Click="Button_OnClick" Style="{StaticResource CalculatorButtonStyle}"/>
                    <Button Content="⌫" Click="BackspaceButton_OnClick" Style="{StaticResource MemoryButtonStyle}"/>
                    <Button Content="=" Click="EqualsButton_OnClick" Style="{StaticResource EqualsButtonStyle}"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="14"
                Background="#1C2A36"
                BorderBrush="#33485B"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="История"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <ListBox x:Name="HistoryListBox"
                         Grid.Row="1"
                         Background="#14212B"
                         BorderBrush="#33485B"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="14"
                         Padding="6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
