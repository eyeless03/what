<Window x:Class="Lab7CustomButtons.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Пользовательские шаблоны кнопок"
        Height="640"
        Width="920"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#10141F">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A7B0C0"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#182133"/>
        <SolidColorBrush x:Key="ButtonBaseBrush" Color="#24304A"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#36517D"/>
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DisabledBrush" Color="#3B4252"/>

        <Style x:Key="NeonButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBaseBrush}"/>
            <Setter Property="BorderBrush" Value="#4F7CFF"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow"
                                    Margin="2"
                                    Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="18"
                                    Opacity="0.18">
                                <Border.Effect>
                                    <BlurEffect Radius="16"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ButtonChrome"
                                    Background="{StaticResource ButtonBaseBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16">
                                <Grid>
                                    <Rectangle x:Name="TopLight"
                                               Height="2"
                                               VerticalAlignment="Top"
                                               Margin="14,8"
                                               Fill="White"
                                               Opacity="0.28"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.46"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.045" ScaleY="1.045"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                                <Setter TargetName="TopLight" Property="Opacity" Value="0.6"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B95A7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource DisabledBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#596171"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Лабораторная работа 7"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"/>
            <TextBlock Text="ControlTemplate для кнопок"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="32"
                       FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="22"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#2C3A58"
                BorderThickness="1"
                CornerRadius="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Создать" Click="DemoButton_OnClick" Style="{StaticResource NeonButtonStyle}"/>
                    <Button Content="Сохранить" Click="DemoButton_OnClick" Style="{StaticResource NeonButtonStyle}" BorderBrush="#2DD4BF"/>
                    <Button Content="Отправить" Click="DemoButton_OnClick" Style="{StaticResource NeonButtonStyle}" BorderBrush="#F472B6"/>
                    <Button Content="Настройки" Click="DemoButton_OnClick" Style="{StaticResource NeonButtonStyle}" BorderBrush="#A78BFA"/>
                    <Button Content="Недоступно" IsEnabled="False" Style="{StaticResource NeonButtonStyle}"/>
                </WrapPanel>

                <Border Grid.Column="1"
                        Padding="18"
                        Background="#101827"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Проверка состояний"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Наведи курсор, нажми кнопку и сравни отключенное состояние."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,18"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Кнопки готовы к тестированию."
                                   Foreground="#2DD4BF"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="2,14,2,0"
                   Text="Шаблон использует Border, Grid, Rectangle, триггеры IsMouseOver / IsPressed / IsEnabled и плавные анимации цвета, свечения и масштаба."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
