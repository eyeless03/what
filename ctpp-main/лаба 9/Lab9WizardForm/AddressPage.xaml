<Page x:Class="Lab9WizardForm.AddressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Адрес">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Адрес" FontSize="28" FontWeight="Bold" Foreground="#1E3A5F"/>
            <TextBlock Text="Финальный шаг: город, улица, дом и квартира при наличии." Foreground="#64748B" Margin="0,6,0,20"/>
            <TextBlock Text="Город"/>
            <TextBox x:Name="CityTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock Text="Улица"/>
            <TextBox x:Name="StreetTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock Text="Номер дома"/>
            <TextBox x:Name="HouseTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock Text="Номер квартиры (опционально)"/>
            <TextBox x:Name="ApartmentTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад" Width="120" Height="40" Margin="0,0,10,0" Click="BackButton_OnClick"/>
            <Button Content="Отправить" Width="130" Height="40" Click="SubmitButton_OnClick"/>
        </StackPanel>
    </Grid>
</Page>
