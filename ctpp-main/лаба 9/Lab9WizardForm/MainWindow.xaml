<Window x:Class="Lab9WizardForm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Многоступенчатая форма"
        Height="660"
        Width="900"
        MinHeight="580"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="18"
                Background="#1E3A5F"
                CornerRadius="18"
                Margin="0,0,0,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Лабораторная работа 9"
                               Foreground="#B9D7F2"
                               FontSize="13"/>
                    <TextBlock Text="Многоступенчатая форма"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="StepTextBlock"
                           DockPanel.Dock="Right"
                           Foreground="#FDE68A"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="Шаг 1 из 3"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1.5"
                CornerRadius="18">
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Navigated="MainFrame_OnNavigated"/>
        </Border>
    </Grid>
</Window>
