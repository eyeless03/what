<Page x:Class="Lab9WizardForm.PersonalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личные данные"
      Background="Transparent">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Личные данные" FontSize="28" FontWeight="Bold" Foreground="#1E3A5F"/>
            <TextBlock Text="Заполните имя, фамилию и дату рождения." Foreground="#64748B" Margin="0,6,0,20"/>
            <TextBlock Text="Имя"/>
            <TextBox x:Name="FirstNameTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock Text="Фамилия"/>
            <TextBox x:Name="LastNameTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock Text="Дата рождения"/>
            <DatePicker x:Name="BirthDatePicker" Height="36" Margin="0,6,0,12"/>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Row="2" Content="Далее" Width="130" Height="40" HorizontalAlignment="Right" Click="NextButton_OnClick"/>
    </Grid>
</Page>
