<Page x:Class="Lab9WizardForm.ContactPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Контактные данные">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Контактные данные" FontSize="28" FontWeight="Bold" Foreground="#1E3A5F"/>
            <TextBlock Text="Укажите email и телефон. Формат проверяется перед переходом." Foreground="#64748B" Margin="0,6,0,20"/>
            <TextBlock Text="Электронная почта"/>
            <TextBox x:Name="EmailTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock Text="Телефон"/>
            <TextBox x:Name="PhoneTextBox" Height="36" Margin="0,6,0,12"/>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад" Width="120" Height="40" Margin="0,0,10,0" Click="BackButton_OnClick"/>
            <Button Content="Далее" Width="120" Height="40" Click="NextButton_OnClick"/>
        </StackPanel>
    </Grid>
</Page>
