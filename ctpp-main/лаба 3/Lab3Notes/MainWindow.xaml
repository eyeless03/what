<Window x:Class="Lab3Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Заметки"
        Height="640"
        Width="980"
        MinHeight="580"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        Closing="Window_OnClosing"
        KeyDown="Window_OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#243447"/>
        <SolidColorBrush x:Key="EditorBrush" Color="#FFF7D6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A7B0BD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0F8FC5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#35C48B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#455468"/>
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#C24141"/>
        </Style>

        <DataTemplate x:Key="NoteItemTemplate">
            <Border Margin="0,0,0,8"
                    Padding="10"
                    Background="#17212F"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Preview}"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PinMarker}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="16"
                               Margin="8,0,0,0"/>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Meta}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Лабораторная работа 3"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"/>
                <TextBlock Text="Менеджер заметок"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="30"
                           FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="SaveIndicatorTextBlock"
                       DockPanel.Dock="Right"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="13"
                       VerticalAlignment="Bottom"
                       Text="Готово к работе"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Мои заметки"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="SearchTextBox"
                                 Height="38"
                                 Padding="10,0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Background="#0F172A"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="#334155"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 TextChanged="SearchTextBox_OnTextChanged"/>
                    </Grid>

                    <ListBox x:Name="NotesListBox"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource NoteItemTemplate}"
                             SelectionChanged="NotesListBox_OnSelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <CheckBox x:Name="PinCheckBox"
                                  DockPanel.Dock="Right"
                                  Content="Закрепить"
                                  Foreground="{StaticResource TextBrush}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Редактор"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Ctrl+N новая, Ctrl+S сохранить, Delete удалить"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBox x:Name="NoteEditorTextBox"
                             Grid.Row="1"
                             Padding="14"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontSize="16"
                             Background="{StaticResource EditorBrush}"
                             Foreground="#1F2937"
                             BorderBrush="#FACC15"
                             CaretBrush="#111827"
                             TextChanged="NoteEditorTextBox_OnTextChanged">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Цвет фона">
                                    <MenuItem Header="Тёплый лист" Click="SetYellowBackground_OnClick"/>
                                    <MenuItem Header="Белый" Click="SetWhiteBackground_OnClick"/>
                                    <MenuItem Header="Голубой" Click="SetBlueBackground_OnClick"/>
                                    <MenuItem Header="Зелёный" Click="SetGreenBackground_OnClick"/>
                                </MenuItem>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>

                    <WrapPanel Grid.Row="2" Margin="0,14,0,4">
                        <Button Content="Добавить" Click="AddButton_OnClick" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Сохранить" Click="SaveButton_OnClick" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Новая" Click="NewButton_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Дубликат" Click="DuplicateButton_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Удалить" Click="DeleteButton_OnClick" Style="{StaticResource DangerButtonStyle}"/>
                    </WrapPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Введите новую заметку или выберите существующую."/>
                        <TextBlock x:Name="StatsTextBlock"
                                   Grid.Column="1"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0"
                                   Text="0 слов / 0 символов"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="2,12,2,0"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Text="Фишки: закрепление важных заметок, быстрые клавиши, дублирование, поиск и автосохранение после изменений."/>
    </Grid>
</Window>
